# ============================================
# Revora — GTM Intelligence OS
# Environment Variables Template
# Copy to .env and fill in values
# ⚠️  NEVER commit .env to git
# ============================================

# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://revora:revora_dev_secret@localhost:5432/revora_dev
DATABASE_DIRECT_URL=postgresql://revora:revora_dev_secret@localhost:5432/revora_dev

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# JWT (for API-to-API auth)
JWT_SECRET=change-me-in-production-min-32-chars

# AI Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GEMINI_API_KEY=...

# Inngest (workflow engine)
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Calendar
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback

# Nango (OAuth + integration platform)
NANGO_SECRET_KEY=...
NANGO_HOST=http://localhost:3003

# Unipile (messaging channels)
UNIPILE_API_KEY=...
UNIPILE_DSN=...

# Slack (notifications)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APPROVAL_CHANNEL_ID=C...

# Email Provider (e.g., Resend)
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@yourdomain.com

# Observability (OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=revora-api

# Encryption (for stored OAuth credentials)
ENCRYPTION_KEY=64-char-hex-string-for-aes-256-encryption

# Feature Flags
ENABLE_AUTONOMOUS_SENDING=false
ENABLE_AUTO_ENRICHMENT=true
ENABLE_EVALUATION=true
MAX_AGENT_TURNS=10
MAX_AGENT_DEPTH=3
DEFAULT_COST_CEILING_USD=1.00
